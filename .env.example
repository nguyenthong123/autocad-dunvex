# ============================================================================
# DUNVEX CAD (CHILI3D) - FILE KHAI BÁO MẪU BIẾN MÔI TRƯỜNG (.env.example)
# Hướng dẫn: Sao chép file này thành `.env` (cp .env.example .env) và điền
# thông số thực tế để sử dụng cho các script bảo trì và deploy tự động.
# Xem chi tiết tại: docs/MAINTENANCE.md
# ============================================================================

# 1. Thông tin định danh dự án & Kho mã nguồn GitHub
PROJECT_NAME=autocad-dunvex
GITHUB_USER=nguyenthong123
GITHUB_REPO=autocad-dunvex
GITHUB_REMOTE_URL=https://github.com/nguyenthong123/autocad-dunvex.git

# 2. Thông tin Máy chủ VPS (Google Cloud Compute Engine)
VPS_PROVIDER=Google_Cloud_Compute_Engine
VPS_PROJECT_ID=dunvex-cad
VPS_INSTANCE_NAME=cad-server
VPS_ZONE=us-west1-a
VPS_INTERNAL_IP=10.138.0.2
VPS_HOST=136.66.95.155
VPS_PORT=22
VPS_USER=zomby
VPS_SSH_KEY_PATH=/Users/zomby/.ssh/id_ed25519_autocad_dunvex
VPS_DEPLOY_DIR=/opt/autocad-dunvex

# 3. Thông số Cổng dịch vụ & Lưu trữ Cloud Storage API
APP_PUBLIC_PORT=80
APP_FALLBACK_PORT=8080
STORAGE_API_PORT=3000
STORAGE_DATA_DIR=/data/storage
APP_DOMAIN=
